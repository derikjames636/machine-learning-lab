   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from sklearn.datasets import fetch_california_housing\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.metrics  import mean_squared_error, r2_score"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "39d34bf7-f8f5-4daf-bde9-dcdb5f728b49",
   "metadata": {},
   "outputs": [],
   "source": [
    "#load dataset\n",
    "housing=fetch_california_housing()\n",
    "data=pd.DataFrame(housing.data,columns=housing.feature_names)\n",
    "data[\"Price\"]=housing.target"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "5f960525-bf37-43ed-8124-7d19caf9c2f7",
   "metadata": {},
   "outputs": [],
   "source": [
    "#select one feature\n",
    "X=data[['AveRooms']].values\n",
    "Y=data['Price'].values"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "4bbaa55f-121b-48a0-af26-7f0a4084ab96",
   "metadata": {},
   "outputs": [],
   "source": [
    "# split data\n",
    "X_train,X_test,Y_train,Y_test=train_test_split(\n",
    "    X, Y,\n",
    "    test_size=0.2,\n",
    "    random_state=42\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "0146ea49-6e4a-499a-bf7a-18fe756c2e88",
   "metadata": {},
   "outputs": [],
   "source": [
    "#feature scaling\n",
    "scaler=StandardScaler()\n",
    "\n",
    "X_train_scaled=scaler.fit_transform(X_train)\n",
    "X_test_scaled=scaler.transform(X_test)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 52,
   "id": "a561d715-671f-41de-bb35-919cb7d213c7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Epoch 0, Cost=2.8149\n",
      "Epoch 100, Cost=0.9414\n",
      "Epoch 200, Cost=0.6904\n",
      "Epoch 300, Cost=0.6568\n",
      "Epoch 400, Cost=0.6523\n",
      "Epoch 500, Cost=0.6517\n",
      "Epoch 600, Cost=0.6516\n",
      "Epoch 700, Cost=0.6516\n",
      "Epoch 800, Cost=0.6516\n",
      "Epoch 900, Cost=0.6516\n"
     ]
    }
   ],
   "source": [
    "w = 0\n",
    "b = 0\n",
    "learning_rate = 0.01\n",
    "epochs = 1000\n",
    "\n",
    "cost_history = []\n",
    "\n",
    "n = len(X_train_scaled)\n",
    "\n",
    "for i in range(epochs):\n",
    "    Y_pred = w * X_train_scaled.flatten() + b\n",
    "\n",
    "    # Compute cost\n",
    "    cost = (1/(2*n)) * np.sum((Y_pred - Y_train)**2)\n",
    "    cost_history.append(cost)\n",
    "\n",
    "    dw = (1/n) * np.sum((Y_pred - Y_train) * X_train_scaled.flatten())\n",
    "    db = (1/n) * np.sum(Y_pred - Y_train)\n",
    "\n",
    "    w = w - learning_rate * dw\n",
    "    b = b - learning_rate * db\n",
    "\n",
    "    if i % 100 == 0:\n",
    "        print(f\"Epoch {i}, Cost={cost:.4f}\")\n",
    "\n",
    "Y_pred_gd = w * X_test_scaled.flatten() + b\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 47,
   "id": "0caadf96-de8b-44d7-a736-b331d262d2e4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Gradient Descent\n",
      "----------------\n",
      "weight: 0.18323090648660517\n",
      "Bias: 2.0718574888450205\n",
      "MSE: 1.292327655590046\n",
      "R2 SCore: 0.013798228607320828\n"
     ]
    }
   ],
   "source": [
    "print(\"Gradient Descent\")\n",
    "print(\"----------------\")\n",
    "print(\"weight:\",w)\n",
    "print(\"Bias:\",b)\n",
    "print(\"MSE:\",mean_squared_error(Y_test,Y_pred_gd))\n",
    "print(\"R2 SCore:\",r2_score(Y_test,Y_pred_gd))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 48,
   "id": "02da8148-f2d0-46a8-a9c5-a0b20ae33f1a",
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train_ne=np.c_[np.ones((len(X_train),1)),X_train]\n",
    "X_test_ne=np.c_[np.ones((len(X_test),1)),X_test]\n",
    "theta=np.linalg.inv(X_train_ne.T @ X_train_ne)@ X_train_ne.T @ Y_train\n",
    "Y_pred_ne=X_test_ne @ theta"
   ]
  },
  {
